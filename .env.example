# Root directory for the library, projects and logs (default: ./data)
LITFORGE_HOME=./data

# Optional path to a YAML config overriding configs/default.yaml
# LITFORGE_CONFIG=./configs/default.yaml

# Local LLM endpoint (used from the screening phase onward)
# LITFORGE_OLLAMA_URL=http://localhost:11434

# Optional: OpenAlex API key (without one, OpenAlex allows a small free daily budget)
# LITFORGE_OPENALEX_API_KEY=
# Optional: contact e-mail for OpenAlex/Crossref polite pools
# LITFORGE_MAILTO=
